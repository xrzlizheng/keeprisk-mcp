# KeepRisk MCP 配置样例
# 用法：cp .env.example .env，然后填入真实值。.env 已被 .gitignore 忽略，不会入库。
#
# ⚠️ 本仓库不包含任何 API Key / Token / AppCode。
#    入站授权 token 与上游 AppCode 均由管理员统一发放，请联系作者开通：
#    https://github.com/xrzlizheng （提 Issue 或 Discussion 均可）

# 上游网关根地址（无尾斜杠）
KEEPRISK_API_BASE="https://api.keeprisk.com:9080"

# 入站鉴权映射组：Authorization token -> AppCode
# token 由管理员随机生成后发放；客户端用法：Authorization: <token>（兼容 Bearer 前缀）
# 正式环境推荐改用文件模式 + SIGHUP 热更新，见 README「鉴权与多租户」一节
KEEPRISK_AUTH_MAP='{"kpm_请填入管理员发放的token":"请填入对应的AppCode"}'

# pcode 级网关路由（可选）：按接口编码覆盖默认网关地址与 AppCode
# KEEPRISK_API_ROUTES='{"E_007_1441":{"base_url":"https://api.keeprisk.com:9080","app_code":"..."}}'
